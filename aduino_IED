// ========================================
// LCD 출력
// ========================================

void showLCD(
const char\* line1,
const char\* line2
)
{
static String previousLine1 = "";
static String previousLine2 = "";
```
// 같은 내용이면 LCD를 다시 clear하지 않음
if (
    previousLine1 == line1 &&
    previousLine2 == line2
)
{
    return;
}

previousLine1 = line1;
previousLine2 = line2;

lcd.clear();

lcd.setCursor(0, 0);
lcd.print(line1);

lcd.setCursor(0, 1);
lcd.print(line2);
```

}

// ========================================
// 초음파 거리 측정
// ========================================

float getDistance()
{
digitalWrite(pinTrig, LOW);
delayMicroseconds(2);
```
digitalWrite(pinTrig, HIGH);
delayMicroseconds(10);

digitalWrite(pinTrig, LOW);

unsigned long duration =
    pulseIn(
        pinEcho,
        HIGH,
        30000
    );

if (duration == 0)
{
    return -1;
}

float distance =
    duration * 0.0343 / 2.0;

return distance;
```

}
